# Port the Bun server listens on
PORT=3090
# Admin dashboard password (use a long one)
ADMIN_PASSWORD=change-me-to-a-long-password
# Secret for signing admin login tokens (random 32+ chars: openssl rand -hex 32)
JWT_SECRET=change-me-random-secret
# Where the SQLite file and photos are stored (keep outside the code folder in production)
DATA_DIR=./data
# Public URL of the site, used in the QR code
PUBLIC_URL=https://worker.revnextrelation.com
